# Self-host configuration for Gigboy (Docker Compose deployment).
# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# UID/GID the postgres container runs as, and the owner the ./data/postgres bind mount needs on
# the host. Defaults to 999 (the postgres image's built-in "postgres" user) — only change these
# if you want Postgres to run as a specific host user (e.g. your own UID, so you can read/manage
# ./data/postgres without sudo). Whatever you set here, chown ./data/postgres to match BEFORE the
# first `docker compose up`, e.g.: mkdir -p data/postgres && chown -R 999:999 data/postgres
PUID=999
PGID=999

# Postgres password used by both the `postgres` service and DATABASE_URL below — keep them in sync.
POSTGRES_PASSWORD=change-me

# Connection string the app server uses to reach Postgres. Required, no fallback — the app
# fails fast at startup if this is unset. When running via docker-compose, "postgres" is the
# service hostname; the password must match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://gigboy:change-me@postgres:5432/gigboy

# Secret used to sign session cookies. Required, no fallback. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Port the app server listens on inside the container.
PORT=6168

# Whether session cookies get the `Secure` flag (only sent over HTTPS). Leave unset/false if
# you're accessing Gigboy directly over http:// (e.g. http://<nas-ip>:6168) — a Secure cookie
# would be silently dropped by the browser and login would appear to work but every API call
# would 401. Set to "true" only once a reverse proxy in front of the container terminates HTTPS.
COOKIE_SECURE=false

# Optional but recommended once a reverse proxy / public domain is in front of the container:
# the canonical public origin (scheme + host, no trailing slash) used to build invite links,
# press-kit share URLs and Open Graph tags. When unset these are derived from the request's
# Host header, which a client can forge (link/cache poisoning). Example:
#   PUBLIC_ORIGIN=https://gigboy.example.com
PUBLIC_ORIGIN=

# How many reverse-proxy hops to trust for the client IP (used by the auth rate limiter).
# Default "false" (correct when the container is exposed directly). Set to "1" for a single
# proxy in front, or a subnet/list per Express's "trust proxy" docs. Don't set "1" without an
# actual proxy — X-Forwarded-For would then be client-spoofable.
TRUST_PROXY=false

# Optional: bootstrap an initial admin account on first run (the migrations + bootstrap step runs
# once before the server starts). With passwords on (the default), set BOTH of these. With
# AUTH_PASSWORDS=false, set only ADMIN_EMAIL — the admin signs in with an emailed code. Leave them
# unset if an admin account already exists from a previous run. A mismatch is a startup error.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Sign-in methods ──────────────────────────────────────────────────────────────────────────
# Turn each on or off with true/false. The server refuses to start with a combination that would
# leave people unable to sign in, and says what's missing.
#
# AUTH_PASSWORDS   — email + password. The default, and works on any setup.
# AUTH_MAGIC_LINKS — email a one-time link + 6-digit code. Needs the SMTP_* settings below and
#                    PUBLIC_ORIGIN. Also how people get back in after forgetting a password or
#                    losing a passkey. The code is what an installed (home-screen) app uses.
# AUTH_PASSKEYS    — fingerprint / face / screen-lock sign-in. Needs PUBLIC_ORIGIN on https://
#                    with a domain name (not an IP), and AUTH_PASSWORDS or AUTH_MAGIC_LINKS too,
#                    so people can sign in to add their first passkey.
#
# Fully passwordless: AUTH_PASSWORDS=false, AUTH_MAGIC_LINKS=true, AUTH_PASSKEYS=true.
AUTH_PASSWORDS=true
AUTH_MAGIC_LINKS=false
AUTH_PASSKEYS=false

# Outgoing mail, for AUTH_MAGIC_LINKS. Any SMTP server or provider works. SMTP_PORT defaults to
# 587 (STARTTLS); 465 switches to implicit TLS (override with SMTP_SECURE=true/false).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The sender address, e.g. Gigboy <gigboy@example.com>
SMTP_FROM=

# ─── Ultimate Guitar ──────────────────────────────────────────────────────────────────────────
# Search Ultimate Guitar and import songs by link from the song form. The server makes these
# requests (UG can't be read from the browser); answers are cached. Set to false to turn search
# and link import off. Importing a file shared from the UG app (lyrics_tmp) never contacts UG and
# works either way.
ULTIMATE_GUITAR_SEARCH=true
# Most requests the server sends Ultimate Guitar per hour, across all users (cached answers don't
# count). Past it, users are asked to try again later.
ULTIMATE_GUITAR_MAX_REQUESTS_PER_HOUR=60
